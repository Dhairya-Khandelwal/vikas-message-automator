# Vikas Message Automator – Environment Configuration
# Copy this file to .env and adjust values for your installation.

# Server binding – default is localhost only (recommended)
BIND_HOST=127.0.0.1
PORT=3000

# Session secret – MUST be a long random string (>= 32 characters).
# Leave blank to auto-generate and persist under data/session.secret
# SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Node environment
NODE_ENV=development

# Optional: trust proxy headers only when running behind a reverse proxy
# TRUST_PROXY=1
