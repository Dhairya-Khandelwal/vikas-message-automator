# Copy to .env on the server:  cp .env.production.example .env
NODE_ENV=production
BIND_HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1

# Only valid when you open the app via https (Caddy / Cloudflare Tunnel).
# Remove if testing over plain http.
FORCE_SECURE_COOKIE=1

# Optional (auto-generated into data/session.secret if left out). Min 32 chars.
# SESSION_SECRET=
